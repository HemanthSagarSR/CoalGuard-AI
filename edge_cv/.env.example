# CoalGuard Edge Vision configuration
EDGE_CV_HOST=0.0.0.0
EDGE_CV_PORT=8000

# 0 = webcam, or a local video path, or an RTSP URL
CV_SOURCE=0
CV_MODEL_PATH=edge_cv/models/best.pt
CV_CONFIDENCE=0.35
CV_IOU=0.45
CV_ZONE=A
CV_STREAM_FPS=12

# Keep false for real YOLO inference.
# Set true only when you need to demo the UI without a trained model.
CV_DEMO_MODE=false

# Optional: draw the virtual zone rectangle on the stream.
CV_ZONE_X1=0
CV_ZONE_Y1=0
CV_ZONE_X2=1280
CV_ZONE_Y2=720
